{
  "mcpServers": {
    "playwright": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "microsoft-learn": {
      "type": "http",
      "url": "https://learn.microsoft.com/api/mcp",
      "tools": ["*"]
    },
    "aspire": {
      "tools": [
        "*"
      ],
      "type": "local",
      "command": "aspire",
      "args": [
        "mcp",
        "start"
      ]
    }
  }
}
